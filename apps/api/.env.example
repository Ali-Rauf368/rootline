# Copy to apps/api/.env — everything is optional for local development.
# DATABASE_URL=postgresql://user:pass@host:5432/rootline     # default: project-local cluster on :55434
# REDIS_URL=redis://localhost:6379                            # enables BullMQ; otherwise the Postgres queue is used
# ANTHROPIC_API_KEY=sk-ant-...                                # enables the Claude agent (default model claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_MODE=auto                                             # auto | claude | heuristic
# GITHUB_TOKEN=ghp_...                                        # real draft PRs (services.repo must be owner/name)
# GITHUB_WEBHOOK_SECRET=...
# JWT_SECRET=change-me-to-a-long-random-string
# INGEST_TOKEN=rl_dev_ingest_token
# SIMULATOR=on
